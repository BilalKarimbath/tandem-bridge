{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "grants"],
  "properties": {
    "version": {"const": 1},
    "grants": {"type": "array", "items": {"$ref": "#/$defs/grant"}}
  },
  "$defs": {
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["agent", "session_id"],
      "properties": {"agent": {"enum": ["codex", "claude"]}, "session_id": {"type": "string", "format": "uuid"}}
    },
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_id", "sender", "receiver", "sender_project", "receiver_project", "ledger", "bookkeeping", "modes", "purposes", "readable_scope", "exclusions", "expires"],
      "properties": {
        "grant_id": {"type": "string", "minLength": 1},
        "sender": {"$ref": "#/$defs/endpoint"}, "receiver": {"$ref": "#/$defs/endpoint"},
        "sender_project": {"type": "string"}, "receiver_project": {"type": "string"}, "ledger": {"type": "string"},
        "bookkeeping": {"$ref": "#/$defs/paths"}, "readable_scope": {"$ref": "#/$defs/paths"}, "exclusions": {"$ref": "#/$defs/paths"},
        "modes": {"const": ["read-only"]},
        "purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["status", "review"]}},
        "expires": {"type": "string", "format": "date-time"},
        "enrolled_by": {"type": "string"}, "note": {"type": "string"}
      }
    }
  }
}
